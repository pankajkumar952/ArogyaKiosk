# ─────────────────────────────────────────────────────────────────
# ArogyaKiosk — Environment Variables
# Created by Er. Pankaj Kumar
# ─────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Gemini AI (REQUIRED — get from aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Session Secret (REQUIRED — just keep this as is for local)
NEXTAUTH_SECRET=

# ── Bhashini (SKIP for now — using Web Speech API instead)
BHASHINI_USER_ID=skip
BHASHINI_API_KEY=skip
NEXT_PUBLIC_BHASHINI_PIPELINE_ID=skip
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# ── ABDM Sandbox (SKIP for now — not needed to run locally)
ABDM_CLIENT_ID=skip
ABDM_CLIENT_SECRET=skip
ABDM_BASE_URL=https://dev.abdm.gov.in
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/api/hiecm/gateway/v3
ABDM_ABHA_URL=https://abhasbx.abdm.gov.in/abha/api/v3

# ── Database (NOT needed for Phase 1 — leave commented out)
# DATABASE_URL=postgresql://user:password@localhost:5432/arogyakiosk

# ── Redis (NOT needed for Phase 1 — leave commented out)
# REDIS_URL=redis://localhost:6379